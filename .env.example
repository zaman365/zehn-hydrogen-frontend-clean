# Shopify Hydrogen Environment Variables
# This is a template file. Copy to .env and populate with actual values.
# Use 'npx shopify hydrogen env pull' to fetch these from your Shopify storefront.

# ============================================================================
# AUTOMATICALLY PULLED FROM SHOPIFY (DO NOT EDIT MANUALLY)
# Run: npx shopify hydrogen env pull --force
# ============================================================================

# Storefront identification
PUBLIC_STOREFRONT_ID=

# Public storefront API token for client-side GraphQL queries
PUBLIC_STOREFRONT_API_TOKEN=

# Your Shopify store domain (without https://)
PUBLIC_STORE_DOMAIN=ipnjut-hz.myshopify.com

# Private storefront API token for server-side operations (KEEP SECRET)
PRIVATE_STOREFRONT_API_TOKEN=

# Customer Account API configuration for customer authentication
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Checkout domain for analytics consent
PUBLIC_CHECKOUT_DOMAIN=ipnjut-hz.myshopify.com

# Shopify shop ID
SHOP_ID=

# Session secret for encrypting session data (KEEP SECRET)
SESSION_SECRET=

# ============================================================================
# OPTIONAL VARIABLES (Add if needed)
# ============================================================================

# Oxygen deployment token for production deployments
# OXYGEN_DEPLOYMENT_TOKEN=

# Meta (Facebook) Pixel ID — required for Meta Pixel tracking
# PUBLIC_META_PIXEL_ID=

# Custom environment variables
# PUBLIC_ANALYTICS_ID=
# CUSTOM_API_ENDPOINT=

# ============================================================================
# OPTIONAL — PRODUCTION FEATURES (not required for typecheck / vitest)
# Missing locally = expected. Failures on these routes are ENV gaps, not code bugs.
# Set in Oxygen for zehnfashion.de production. See Docs/project-idea/SHOPIFY_WEBHOOK_SETUP.md
# ============================================================================

# ----------------------------------------------------------------------------
# AI CHAT (OpenRouter + DeepSeek) — POST /api/chat
# ----------------------------------------------------------------------------

# Get your key at: https://openrouter.ai/keys
# Without this: chat widget returns 500 "KI-Service nicht konfiguriert" — CORRECT behavior.
OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# SHOPIFY WEBHOOKS (cache purge) — POST https://zehnfashion.de/webhooks
# ----------------------------------------------------------------------------

# NOT a random string — Custom App "API secret key" from:
#   Shopify Admin → Settings → Apps and sales channels → Develop apps
#   → [Hydrogen/store app] → API credentials → API secret key
# Without this: HMAC verification skipped in dev — CORRECT. Must be set in Oxygen prod.
# Register 6 webhooks in Admin → Notifications → URL: https://zehnfashion.de/webhooks
#   Events: Product update|creation|deletion + Collection update|creation|deletion
SHOPIFY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# CONTACT FORM (Resend) — POST /api/contact
# ----------------------------------------------------------------------------

# Get key at: https://resend.com
# Without this: contact form returns 500 "E-Mail-Service ist nicht konfiguriert" — CORRECT.
RESEND_API_KEY=
